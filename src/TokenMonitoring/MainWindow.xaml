<Window x:Class="TokenMonitoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Token Monitoring"
        Icon="Assets/app-icon.ico"
        Width="304"
        Height="236"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB4C8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F7FF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="UsageBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#273149" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#74809A" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE4F5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Border Background="#F21A2030"
            BorderBrush="#40506F"
            BorderThickness="1"
            CornerRadius="13"
            Padding="14,11"
            MouseLeftButtonDown="Panel_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.38" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22" />
                <RowDefinition Height="37" />
                <RowDefinition Height="37" />
                <RowDefinition Height="31" />
                <RowDefinition Height="1" />
                <RowDefinition Height="55" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UsageTitleText" Text="CODEX USAGE" Foreground="#7F8BA3" FontSize="10" FontWeight="Bold" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="CONNECTING" Foreground="#7F8BA3" FontSize="9" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="105" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FiveHourLabel" Text="5h left" Style="{StaticResource MetricLabel}" />
                <ProgressBar x:Name="FiveHourBar" Grid.Column="1" Style="{StaticResource UsageBar}" Margin="0,0,10,0" />
                <TextBlock x:Name="FiveHourText" Grid.Column="2" Style="{StaticResource MetricValue}" Text="--" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="105" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WeekLabel" Text="W left" Style="{StaticResource MetricLabel}" />
                <ProgressBar x:Name="WeekBar" Grid.Column="1" Style="{StaticResource UsageBar}" Margin="0,0,10,0" />
                <TextBlock x:Name="WeekText" Grid.Column="2" Style="{StaticResource MetricValue}" Text="--" />
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TodayLabel" Text="Today" Style="{StaticResource MetricLabel}" />
                <TextBlock x:Name="TodayText" Grid.Column="1" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Text="0 tokens" />
                <TextBlock x:Name="UpdatedText" Grid.Column="2" Foreground="#66728C" FontSize="9" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="4" Background="#34405A" Margin="0,0,0,0" />

            <Grid Grid.Row="5" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="InputLabel" Text="INPUT" Style="{StaticResource DetailLabel}" />
                    <TextBlock x:Name="InputTokensText" Text="--" Style="{StaticResource DetailValue}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="OutputLabel" Text="OUTPUT" Style="{StaticResource DetailLabel}" />
                    <TextBlock x:Name="OutputTokensText" Text="--" Style="{StaticResource DetailValue}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="CacheLabel" Text="CACHE" Style="{StaticResource DetailLabel}" />
                    <TextBlock x:Name="CachedTokensText" Text="--" Style="{StaticResource DetailValue}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock x:Name="HitRateLabel" Text="HIT RATE" Style="{StaticResource DetailLabel}" />
                    <TextBlock x:Name="CacheHitRateText" Text="--" Style="{StaticResource DetailValue}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
